# TrueData API credentials.
#
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
#
# The scripts read these with os.getenv(), so the variables must be present in
# the environment before you run them. Either export them in your shell:
#
#   PowerShell:  $env:TRUEDATA_USERNAME = "..."; $env:TRUEDATA_PASSWORD = "..."
#   bash:        export TRUEDATA_USERNAME=... TRUEDATA_PASSWORD=...
#
# ...or load this file automatically by adding to the top of a script:
#
#   from dotenv import load_dotenv; load_dotenv()   # pip install python-dotenv

TRUEDATA_USERNAME=your_truedata_username
TRUEDATA_PASSWORD=your_truedata_password
